# ====================================================================
# Project-specific additions
# ====================================================================

# 1. Prevent build intermediate files (.obj) from being committed
#    Protects .obj files under resources/ (3D models) while excluding build outputs
**/Debug/*.obj
**/Release/*.obj
**/x64/*.obj
**/x86/*.obj

# 2. DCC tool / editor source files
*.blend1
*.xcf
*.aseprite

# 3. Asset editing source folder (original folder) exclusion
#    Exclude the editing source folder under project/Application/ entirely
/project/Application/asset_src/

# ====================================================================
# Project-specific existing paths
# ====================================================================
DirectXGame/DirectXGame.exe
DirectXGame/imgui.ini
**/DirectXTex/Shaders/Compiled/
/project/externals/DirectXTex/Bin/
/project/IrufemiEngine/logs/
/project/Application/logs/
/project/Application/imgui.ini

# ====================================================================
# AntiGravity / AI tools
# ====================================================================

# AntiGravity workflow definitions and task files
.agents/
.agent/
_agents/
_agent/

# Gemini / AntiGravity local cache (if placed inside project)
.gemini/

# Other AI tools (Copilot, Cursor, etc.)
.copilot/
.cursor/

# ====================================================================
# Debug / temporary log files
# ====================================================================
debuglog.txt
*.log
# ====================================================================
# clangd language server cache
# ====================================================================
.cache/
**/.cache/
/gakkousuraido
/project/compile_commands.json
/Dumps
